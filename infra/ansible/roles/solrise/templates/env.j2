# {{ ansible_managed }}
# Rendered by Ansible from group_vars (Terraform facts + Vault). Do not edit on
# the host: change infra/ansible and re-run the playbook.

COMPOSE_PROJECT_NAME=solrise

# --- engine ------------------------------------------------------------------
CONTAINER_ENGINE=podman
COMPOSE_CMD=/home/{{ deploy_user }}/.local/bin/podman-compose
DOCKER_SOCK=/run/user/{{ deploy_uid }}/podman/podman.sock

# --- image -------------------------------------------------------------------
CUSTOM_IMAGE={{ effective_image }}
CUSTOM_TAG={{ custom_tag }}
PULL_POLICY={{ effective_pull_policy }}
FRAPPE_PATH=https://github.com/frappe/frappe
FRAPPE_BRANCH={{ frappe_branch }}
FRAPPE_IMAGE_PREFIX=docker.io/frappe
FRAPPE_DOCKER_DIR=./frappe_docker
SOLRISE_APP_URL={{ solrise_app_url }}
SOLRISE_APP_BRANCH={{ solrise_app_branch }}

# --- database: Amazon RDS (no local mariadb container) -----------------------
DB_HOST={{ rds_host }}
DB_PORT={{ rds_port }}
DB_ROOT_USERNAME={{ db_root_username_effective }}
DB_ROOT_PASSWORD='{{ db_root_password }}'

# --- site + TLS --------------------------------------------------------------
SITE_NAME={{ site_name }}
ADMIN_PASSWORD='{{ admin_password }}'
DOMAIN={{ domain }}
LETSENCRYPT_EMAIL={{ letsencrypt_email }}
HTTP_PORT=80
HTTPS_PORT=443
# Leave TLS_CERT_RESOLVER unset so the default main-resolver issues the real
# Let's Encrypt certificate. (Setting it empty defeats the ${...-default} and
# leaves the router on Traefik's self-signed cert.)

# --- runtime -----------------------------------------------------------------
GUNICORN_WORKERS={{ gunicorn_workers }}
GUNICORN_THREADS={{ gunicorn_threads }}
GUNICORN_TIMEOUT={{ gunicorn_timeout }}
PROXY_READ_TIMEOUT=120
CLIENT_MAX_BODY_SIZE=50m
SOCKETIO_PORT=9000
INSTALL_APPS='{{ effective_install_apps }}'

# --- media: uploaded files go to S3, not to the EC2 volume --------------------
# Empty S3_MEDIA_BUCKET switches the feature off (no app, files stay on the
# volume). The app itself reads these settings from the site config, not from
# the environment: S3_MEDIA_* is the input to scripts/setup-media.sh.
S3_MEDIA_BUCKET={{ media_bucket | default('') }}
S3_MEDIA_REGION={{ aws_region }}
S3_MEDIA_ENDPOINT_URL={{ effective_s3_endpoint_url }}
S3_MEDIA_FOLDER={{ s3_media_folder | default('') }}
S3_MEDIA_PRESIGNED_EXPIRY={{ s3_media_presigned_expiry | default(300) }}
S3_MEDIA_VERIFY={{ 1 if s3_media_verify | default(true) | bool else 0 }}
S3_MEDIA_WRITE_LOCAL={{ 1 if s3_media_write_local | default(false) | bool else 0 }}
S3_MEDIA_MIGRATE_EXISTING={{ 1 if s3_media_migrate_existing | default(false) | bool else 0 }}
S3_MEDIA_MIGRATE_DRY_RUN={{ 1 if s3_media_migrate_dry_run | default(true) | bool else 0 }}
S3_MEDIA_MIGRATE_REMOVE_LOCAL={{ 1 if s3_media_migrate_remove_local | default(false) | bool else 0 }}
# Only fill these in for an S3-compatible service with no instance profile.
S3_MEDIA_ACCESS_KEY={{ s3_media_access_key | default('') }}
S3_MEDIA_SECRET_KEY={{ s3_media_secret_key | default('') }}

# --- volumes -----------------------------------------------------------------
SITES_VOLUME=solrise_sites
REDIS_QUEUE_VOLUME=solrise_redis_queue
LETSENCRYPT_VOLUME=solrise_letsencrypt

# --- backups -----------------------------------------------------------------
BACKUP_DIR={{ effective_backup_dir }}
BACKUP_RETENTION_DAYS={{ backup_retention_days }}
