# Generated by Terraform from live AWS resources - do not edit by hand.
# Secrets are NOT written here: the deploy role reads the RDS master password
# from Secrets Manager at runtime, and the app secrets come from Ansible Vault.
---
aws_region: "${aws_region}"
app_public_ip: "${public_ip}"
domain: "${domain}"
site_name: "${site_name}"
letsencrypt_email: "${letsencrypt_email}"

# RDS MariaDB
rds_host: "${rds_host}"
rds_port: ${rds_port}
db_root_username: "${db_username}"
db_secret_arn: "${db_secret_arn}"

# Optional artifacts (empty string when disabled)
backup_bucket: "${backup_bucket}"
media_bucket: "${media_bucket}"
ecr_repository_url: "${ecr_repository_url}"
