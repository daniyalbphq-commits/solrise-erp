# Secrets - never commit
.env
.env.*
!.env.example

# Vendored frappe_docker checkout
frappe_docker/

# Local/runtime data
sites/
logs/
backups/
compose/compose.rendered.yaml

# Python
__pycache__/
*.py[cod]
.venv/

# Editor / OS
.DS_Store
*.swp
.idea/
.vscode/

# Custom app - maintained in its own repository (see apps.json / SOLRISE_APP_URL)
apps/solrise_erp/

# Terraform
infra/terraform/.terraform/
infra/terraform/*.tfstate
infra/terraform/*.tfstate.*
infra/terraform/crash.log
infra/terraform/crash.*.log
infra/terraform/*.tfvars
!infra/terraform/*.tfvars.example
infra/terraform/override.tf
infra/terraform/override.tf.json
infra/terraform/*_override.tf
infra/terraform/*_override.tf.json
infra/terraform/.terraformrc
infra/terraform/terraform.rc

# Ansible
infra/ansible/*.retry
infra/ansible/collections/
infra/ansible/inventory/hosts.ini
infra/ansible/group_vars/all/terraform.yml
infra/ansible/group_vars/all/vault.yml
# Keep backups/manual copies of the vault out of the repo too (e.g. vault.yml.lost)
infra/ansible/group_vars/all/vault.yml.*
!infra/ansible/group_vars/all/vault.example.yml
